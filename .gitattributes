* text=auto
# Upstream stores AHK sources with literal CRLF bytes; preserve reviewable diffs.
*.ahk -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
lib/SQLiteDB/*.ahk text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.ttf binary
